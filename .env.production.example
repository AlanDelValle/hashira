# Hashira, self-hosted. Copy to `.env` beside compose.yml and fill in the four things that are
# yours: the domain, the key, the database password, and whether you want a socket.
#
#   cp .env.production.example .env
#
# `docs/self-hosting.md` walks the whole thing, including what to do when a certificate will
# not issue.

APP_NAME=Hashira
APP_ENV=production

# Generate one and paste it here. It is what encrypts sessions and cookies, so changing it
# later signs everybody out; losing it is not recoverable in any other sense.
#
#   docker compose run --rm --no-deps app php artisan key:generate --show
APP_KEY=

# Off. On, this prints stack traces — with configuration in them — to whoever caused the error.
APP_DEBUG=false

# The address people type. It is what password-reset links are built from, so a wrong value
# here is mail that nobody can use.
APP_URL=https://hashira.example.com

# What Caddy asks Let's Encrypt for. The same host as APP_URL, without the scheme.
#
# Put `:80` here instead if something in front of this is already terminating TLS — a load
# balancer, or Cloudflare set to Full. Two things trying to hold the same certificate is the
# most common way this fails to come up.
SERVER_NAME=hashira.example.com

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=warning

# The container's own database. `DB_HOST` is the service name in compose.yml, not localhost:
# they are different machines as far as the network is concerned.
DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=hashira
DB_USERNAME=hashira
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

FILESYSTEM_DISK=local
CACHE_STORE=database

# Nothing in this application is queued, so there is no worker container and `sync` is the
# honest setting: anything that ever does get queued runs in the request that made it rather
# than waiting for a worker nobody started.
QUEUE_CONNECTION=sync

# Mail, for password resets and — once organisations arrive — invitations. Any SMTP will do;
# Brevo's free allowance is 300 a day, which is more than a small instance sends in a month.
# Left as `log`, a password reset is written to the log file instead of being delivered, which
# is fine for trying this out and useless the moment somebody else uses it.
MAIL_MAILER=log
MAIL_HOST=smtp-relay.brevo.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="hashira@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Presence, live co-editing, and being told when somebody names you. All optional, and off:
# with `null` the browser is handed an empty key and never opens a connection, and the editor
# is exactly what it is with them on, minus the other people.
#
# To turn it on: set this to `reverb`, fill in the three credentials with values of your own
# choosing (any long random strings — they are a shared secret between PHP and the socket
# server, not something to look up), and start with the profile:
#
#   docker compose --profile presence up -d
BROADCAST_CONNECTION=null

REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=

# Where PHP reaches the socket: the service name, on the compose network, in the clear.
REVERB_HOST=reverb
REVERB_PORT=8080
REVERB_SCHEME=http

# Where the browser reaches it, which is not the same place: it comes in through the front
# door, on 443, and the app container proxies it on. Set the host to your domain.
REVERB_CLIENT_HOST=hashira.example.com
REVERB_CLIENT_PORT=443
REVERB_CLIENT_SCHEME=https

# Nightly, at 03:15, into a volume of its own so that an upgrade replacing the application
# container does not take the copies with it. Copying them off this machine is still yours to
# arrange — a dump on the same disk as the database is not a backup of that disk failing.
BACKUP_PATH=/backups
BACKUP_KEEP_DAYS=14

# Which published image to run, pinned on purpose.
#
# `latest` would mean the next `docker compose pull` brings whatever was released since — and
# before 1.0 that includes migrations that change the shape of what you already have. Upgrading
# should be something you decided to do on a morning you have time for, not something that
# happened while you were pulling for an unrelated reason. Put `latest` here if you would rather
# track the newest release; the release notes say what each one moves.
HASHIRA_VERSION=v0.10.0
