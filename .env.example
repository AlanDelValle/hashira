APP_NAME=Hashira
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://hashira.test

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# PostgreSQL. The drawing itself is stored as JSONB, so Postgres is not optional.
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=hashira
DB_USERNAME=postgres
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null


FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

MAIL_MAILER=log
MAIL_FROM_ADDRESS="hello@hashira.test"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"

# Presence, over a socket. The app works without any of this: with no REVERB_APP_KEY the
# client never opens a connection and nobody sees anybody, which is what CI and a plain
# checkout get. Turning it on means filling these in and running `php artisan reverb:start`.
BROADCAST_CONNECTION=reverb

# The literal address rather than `localhost`: on Windows that resolves to ::1 first,
# and a server listening on 127.0.0.1 is then a server the browser cannot reach.
REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST=127.0.0.1
REVERB_PORT=8080
REVERB_SCHEME=http

# What the browser is built with. Vite inlines these at build time, so they are the switch:
# an empty key is how the client knows there is no socket to talk to.
VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"
