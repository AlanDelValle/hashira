APP_NAME=Hashira
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://hashira.test

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# PostgreSQL. The drawing itself is stored as JSONB, so Postgres is not optional.
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=hashira
DB_USERNAME=postgres
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null


FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

MAIL_MAILER=log
MAIL_FROM_ADDRESS="hello@hashira.test"
MAIL_FROM_NAME="${APP_NAME}"

# Nothing is left. No `VITE_` variable is read by any code here any more, which is the property
# that lets one built bundle serve every instance: what the browser needs to know about a
# deployment comes from `config/hashira.php`, printed into the page, at run time.

# Presence and live co-editing, over a socket. Both are optional and the editor is built to
# stay that way: left at `null` the client never opens a connection, nobody sees anybody, and
# nothing else changes — which is what CI and a plain checkout get. Turning it on means
# setting this to `reverb`, filling in the three credentials below, and running
# `php artisan reverb:start`. Set it to `reverb` without a socket actually running and every
# edit pays a second waiting for a connection that is refused.
BROADCAST_CONNECTION=null

# Where PHP reaches the socket server. The literal address rather than `localhost`: on Windows
# that resolves to ::1 first, and a server listening on 127.0.0.1 is then unreachable.
REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST=127.0.0.1
REVERB_PORT=8080
REVERB_SCHEME=http

# Where the *browser* reaches it, which in production is a different address: PHP goes straight
# to the container over plain HTTP while the browser comes in through the TLS front door, on
# 443. Left commented out these fall back to the three above, which is right for development.
#
# The app key itself is not here and is not a `VITE_` variable any more: `config/hashira.php`
# hands it to the browser at run time, printed into the page. A `VITE_` value is inlined when
# the assets are built, and the assets are built once by CI — so a key in the bundle would be
# CI's empty one on every instance that ever pulled the image.
# REVERB_CLIENT_HOST=
# REVERB_CLIENT_PORT=
# REVERB_CLIENT_SCHEME=
